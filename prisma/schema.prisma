generator client {
  provider = "prisma-client-js"
}

// MongoDB Atlas (replica set required for Prisma transactions)
// Set DATABASE_URL in .env — e.g. mongodb+srv://user:pass@cluster.mongodb.net/product_inventory_manager
datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Shopify session storage (PrismaSessionStorage) — Mongo requires separate _id field
model Session {
  session_id          String    @id @default(auto()) @map("_id") @db.ObjectId
  id                  String    @unique
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean?  @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model Shop {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  shopDomain    String    @unique
  isActive      Boolean   @default(true)
  installedAt   DateTime  @default(now())
  uninstalledAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model WebhookEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  shopDomain String
  topic      String
  webhookId  String?
  payload    Json
  status     String   @default("processed")
  error      String?
  createdAt  DateTime @default(now())

  @@index([shopDomain, createdAt])
}
