# MongoDB Atlas (required locally and on Render)
DATABASE_URL=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/product_inventory_manager?retryWrites=true&w=majority

# Shopify app credentials (Partner Dashboard → Apps → Settings)
# Local `shopify app dev` injects these automatically. Set them yourself on Render.
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SCOPES=read_products,write_products,read_inventory,write_inventory,read_locations

# Public app URL (no trailing slash)
# Local: set by Shopify CLI / tunnel
# Render: https://YOUR-SERVICE.onrender.com
SHOPIFY_APP_URL=https://YOUR-SERVICE.onrender.com

# Optional — only if the shop uses a custom domain
# SHOP_CUSTOM_DOMAIN=your-custom-shop-domain.com
